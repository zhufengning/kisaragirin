{
    "compilerOptions": {
        "target": "ESNext",
        "moduleDetection": "force",
        "module": "Preserve",
        "resolveJsonModule": true,
        "allowJs": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "~/*": ["src/*"],
            "@/*": ["./*"],
            "@lib": ["lib/index.ts"],
            "@lib/*": ["lib/*"]
        }
    },
    "exclude": ["web/", "dist/", "node_modules/"]
}