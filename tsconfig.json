{
    "compilerOptions": {
        "target": "ESNext",
        "moduleDetection": "force",
        "module": "Preserve",
        "resolveJsonModule": true,
        "allowJs": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "paths": {
            "~/*": [
                "./src/*"
            ],
            "@/*": [
                "./*"
            ],
            "@lib": [
                "./lib/index.ts"
            ],
            "@lib/*": [
                "./lib/*"
            ]
        },
        "strict": true
    },
    "exclude": [
        "web/",
        "dist/",
        "node_modules/"
    ]
}