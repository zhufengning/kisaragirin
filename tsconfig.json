{
    "compilerOptions": {
        "target": "ESNext",
        "moduleDetection": "force",
        "module": "Preserve",
        "resolveJsonModule": true,
        "allowJs": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "exclude": ["web/", "dist/", "node_modules/"]
}