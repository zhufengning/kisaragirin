---
import Layout from '@layouts/Layout.astro';
import { db, schema } from '@lib/db';
import { readdirSync } from 'node:fs';

import { like, sql } from 'drizzle-orm';

const IMAGE_DIR = './data/images';
const PAGE_SIZE = 24;

function listImages() {
    try {
        const files = readdirSync(IMAGE_DIR);
        return files.map(name => {
            const dot = name.lastIndexOf('.');
            const sha256 = dot > 0 ? name.slice(0, dot) : name;
            return { name, sha256, ext: dot > 0 ? name.slice(dot) : '' };
        });
    } catch {
        return [];
    }
}

// 获取所有图片文件
const allFiles = listImages();

// 搜索参数
const searchQuery = Astro.url.searchParams.get('search')?.trim() || '';
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

// 如果有搜索词，按描述或 sha256 筛选
let filteredFiles = allFiles;
if (searchQuery) {
    const matchingSet = new Set<string>();

    // 1. 按描述搜索
    const searchPattern = `%${searchQuery}%`;
    const matchingRows = await db
        .select({ sha256: schema.images.sha256 })
        .from(schema.images)
        .where(like(schema.images.description, searchPattern));
    for (const r of matchingRows) matchingSet.add(r.sha256);

    // 2. 按 sha256 搜索（包含匹配）
    const lowerQuery = searchQuery.toLowerCase();
    for (const f of allFiles) {
        if (f.sha256.toLowerCase().includes(lowerQuery)) {
            matchingSet.add(f.sha256);
        }
    }

    filteredFiles = allFiles.filter(f => matchingSet.has(f.sha256));
}

// 分页
const totalCount = filteredFiles.length;
const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
const validPage = Math.min(currentPage, totalPages);
const startIndex = (validPage - 1) * PAGE_SIZE;
const pageFiles = filteredFiles.slice(startIndex, startIndex + PAGE_SIZE);

// 查询当前页图片的描述
const sha256List = pageFiles.map(f => f.sha256);
const descRows = sha256List.length > 0
    ? await db.select().from(schema.images).where(sql`${schema.images.sha256} IN ${sha256List}`)
    : [];
const descMap = new Map(descRows.map(r => [r.sha256, r.description]));

// 构建分页URL
function pageUrl(page: number) {
    const url = new URL(Astro.url);
    url.searchParams.set('page', String(page));
    return url.pathname + url.search;
}

---

<Layout title="图片管理">
    <h1>图片管理 <span class="meta">({totalCount} 张{searchQuery ? ` · 搜索: "${searchQuery}"` : ''})</span></h1>

    <div id="queue-progress" class="queue-progress" style="display: none;">
        <div class="progress-text">
            图片描述生成中，还剩 <span id="queue-remaining">0</span> 张…
        </div>
        <div class="progress-track">
            <div class="progress-bar"></div>
        </div>
    </div>

    <!-- 搜索栏 -->
    <form class="search-bar" method="GET" action="/images">
        <input
            type="text"
            name="search"
            value={searchQuery}
            placeholder="按描述或哈希搜索图片..."
            class="search-input"
        />
        <button type="submit" class="btn">🔍 搜索</button>
        {searchQuery && (
            <a href="/images" class="btn btn-secondary">清除</a>
        )}
    </form>

    <form method="POST" action="/api/images/delete-descriptions" id="batch">
        <div class="grid">
            {pageFiles.map(f => {
                const desc = descMap.get(f.sha256);
                const descText = desc ?? '';
                return (
                    <div class="card" data-sha256={f.sha256}>
                        <img src={`/api/images/file/${f.name}`} alt={f.sha256} loading="lazy" />
                        <div class="info">
                            <div class="sha">{f.sha256.slice(0, 16)}…</div>
                            <div class="desc-wrap" data-desc={descText}>
                                <div class={`desc-view ${desc ? '' : 'empty'}`}>
                                    {desc ?? '（无描述）'}
                                </div>
                                <textarea class="desc-input hidden" rows="3">{descText}</textarea>
                                <div class="desc-actions hidden">
                                    <button type="button" class="btn btn-sm save-desc">保存</button>
                                    <button type="button" class="btn btn-sm btn-secondary cancel-desc">取消</button>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-secondary edit-desc">编辑描述</button>
                        </div>
                        <label class="check">
                            <input type="checkbox" name="sha256" value={f.sha256} /> 选择
                        </label>
                    </div>
                );
            })}
            {pageFiles.length === 0 && (
                <p class="empty">
                    {searchQuery ? '没有找到匹配的图片' : '暂无图片'}
                </p>
            )}
        </div>

        {pageFiles.length > 0 && (
            <div class="toolbar">
                <button type="submit" class="btn btn-secondary btn-sm">🗑️ 删除选中描述</button>
            </div>
        )}
    </form>

    <!-- 分页导航 -->
    {totalPages > 1 && (
        <nav class="pagination">
            <a
                href={pageUrl(validPage - 1)}
                class={`page-btn ${validPage <= 1 ? 'disabled' : ''}`}
                aria-disabled={validPage <= 1}
            >
                ← 上一页
            </a>
            <span class="page-info">
                第 {validPage} / {totalPages} 页
            </span>
            <a
                href={pageUrl(validPage + 1)}
                class={`page-btn ${validPage >= totalPages ? 'disabled' : ''}`}
                aria-disabled={validPage >= totalPages}
            >
                下一页 →
            </a>
        </nav>
    )}

    <form method="POST" action="/api/images/clear-all" class="danger-zone"
        onsubmit="return confirm('确定清空全部图片描述？')"
    >
        <button type="submit" class="btn btn-danger btn-sm">⚠️ 全部清空描述</button>
    </form>
</Layout>

<script>
    const progressEl = document.getElementById('queue-progress');
    const remainingEl = document.getElementById('queue-remaining');
    if (!progressEl || !remainingEl) throw new Error('Elements not found');

    const evtSource = new EventSource('/api/queue-progress');
    evtSource.onmessage = (e) => {
        const data = JSON.parse(e.data);
        const remaining = data.pending + data.processing;

        if (remaining === 0) {
            progressEl.style.display = 'none';
        } else {
            progressEl.style.display = 'block';
            remainingEl.textContent = String(remaining);
        }
    };
    evtSource.onerror = () => {
        evtSource.close();
    };
</script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const grid = document.querySelector('.grid');
        if (!grid) return;

        grid.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const editBtn = target.closest('.edit-desc') as HTMLButtonElement | null;
            if (editBtn) {
                enterEdit(editBtn);
                return;
            }
            const saveBtn = target.closest('.save-desc') as HTMLButtonElement | null;
            if (saveBtn) {
                void saveEdit(saveBtn);
                return;
            }
            const cancelBtn = target.closest('.cancel-desc') as HTMLButtonElement | null;
            if (cancelBtn) {
                cancelEdit(cancelBtn);
            }
        });

        interface EditElements {
            card: HTMLElement;
            wrap: HTMLElement;
            view: HTMLElement;
            input: HTMLTextAreaElement;
            actions: HTMLElement;
            editBtn: HTMLButtonElement;
        }

        function findEditElements(btn: HTMLButtonElement): EditElements | null {
            const card = btn.closest('.card') as HTMLElement | null;
            if (!card) return null;
            const wrap = card.querySelector('.desc-wrap') as HTMLElement | null;
            if (!wrap) return null;
            const view = wrap.querySelector('.desc-view') as HTMLElement | null;
            const input = wrap.querySelector('.desc-input') as HTMLTextAreaElement | null;
            const actions = wrap.querySelector('.desc-actions') as HTMLElement | null;
            const editBtn = card.querySelector('.edit-desc') as HTMLButtonElement | null;
            if (!view || !input || !actions || !editBtn) return null;
            return { card, wrap, view, input, actions, editBtn };
        }

        function enterEdit(btn: HTMLButtonElement) {
            const els = findEditElements(btn);
            if (!els) return;
            const { view, input, actions, editBtn, wrap } = els;
            input.value = wrap.dataset.desc ?? '';
            view.classList.add('hidden');
            editBtn.classList.add('hidden');
            input.classList.remove('hidden');
            actions.classList.remove('hidden');
            input.focus();
            input.select();

            input.onkeydown = (event) => {
                if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
                    const save = actions.querySelector('.save-desc') as HTMLButtonElement | null;
                    if (save) void saveEdit(save);
                } else if (event.key === 'Escape') {
                    const cancel = actions.querySelector('.cancel-desc') as HTMLButtonElement | null;
                    if (cancel) cancelEdit(cancel);
                }
            };
        }

        function cancelEdit(btn: HTMLButtonElement) {
            const els = findEditElements(btn);
            if (!els) return;
            const { view, input, actions, editBtn } = els;
            input.value = '';
            input.onkeydown = null;
            view.classList.remove('hidden');
            editBtn.classList.remove('hidden');
            input.classList.add('hidden');
            actions.classList.add('hidden');
        }

        async function saveEdit(btn: HTMLButtonElement) {
            const els = findEditElements(btn);
            if (!els) return;
            const { card, input, actions } = els;
            const sha256 = card.dataset.sha256;
            if (!sha256) return;

            const saveBtn = actions.querySelector('.save-desc') as HTMLButtonElement | null;
            const cancelBtn = actions.querySelector('.cancel-desc') as HTMLButtonElement | null;
            if (saveBtn) {
                saveBtn.disabled = true;
                saveBtn.textContent = '保存中...';
            }
            if (cancelBtn) cancelBtn.disabled = true;

            try {
                const form = new FormData();
                form.append('sha256', sha256);
                form.append('description', input.value);
                const res = await fetch('/api/images/update-description', {
                    method: 'POST',
                    body: form,
                    credentials: 'same-origin',
                });
                if (!res.ok) throw new Error(await res.text());
                window.location.href = '/images' + window.location.search;
            } catch (err) {
                alert('保存失败: ' + (err as Error).message);
                if (saveBtn) {
                    saveBtn.disabled = false;
                    saveBtn.textContent = '保存';
                }
                if (cancelBtn) cancelBtn.disabled = false;
            }
        }
    });
</script>

<style>
    .search-bar {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }
    .search-input {
        flex: 1;
        min-width: 200px;
        padding: 8px 14px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        font-size: 14px;
        font-family: inherit;
    }
    .search-input:focus {
        outline: none;
        border-color: var(--accent);
    }
    .search-input::placeholder {
        color: var(--text-secondary);
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
    }
    .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: background 0.15s;
    }
    .card:hover { background: var(--surface-hover); }
    .card img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border-bottom: 1px solid var(--border);
    }
    .info { padding: 12px; flex: 1; }
    .sha {
        font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
        font-size: 12px;
        color: var(--text-secondary);
        margin-bottom: 6px;
        word-break: break-all;
    }
    .desc-view {
        font-size: 13px;
        color: var(--text);
        line-height: 1.5;
    }
    .desc-view.empty { color: var(--text-secondary); font-style: italic; }
    .edit-desc { margin-top: 10px; }
    .desc-input {
        width: 100%;
        min-height: 64px;
        padding: 8px 10px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text);
        font-size: 13px;
        font-family: inherit;
        line-height: 1.5;
        resize: vertical;
    }
    .desc-input:focus {
        outline: none;
        border-color: var(--accent);
    }
    .desc-actions {
        display: flex;
        gap: 8px;
        margin-top: 8px;
    }
    .hidden { display: none; }
    .check {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 10px 12px;
        border-top: 1px solid var(--border);
        font-size: 13px;
        color: var(--text-secondary);
        cursor: pointer;
    }
    .check input { accent-color: var(--accent); }
    .empty { grid-column: 1 / -1; color: var(--text-secondary); text-align: center; padding: 40px; }
    .danger-zone {
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
    }
    .queue-progress {
        margin-bottom: 16px;
        padding: 12px 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
    }
    .progress-text {
        font-size: 13px;
        color: var(--text-secondary);
        margin-bottom: 8px;
    }
    .progress-track {
        height: 6px;
        background: var(--border);
        border-radius: 3px;
        overflow: hidden;
    }
    .progress-bar {
        height: 100%;
        width: 40%;
        background: linear-gradient(90deg, var(--accent), var(--accent-hover));
        border-radius: 3px;
        animation: indeterminate 1.2s infinite ease-in-out;
    }
    @keyframes indeterminate {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(300%); }
    }
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
        padding: 16px;
    }
    .page-btn {
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        font-size: 14px;
        text-decoration: none;
        transition: background 0.15s;
    }
    .page-btn:hover:not(.disabled) {
        background: var(--surface-hover);
        text-decoration: none;
    }
    .page-btn.disabled {
        opacity: 0.4;
        cursor: not-allowed;
        pointer-events: none;
    }
    .page-info {
        font-size: 14px;
        color: var(--text-secondary);
    }
</style>
