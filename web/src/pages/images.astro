---
import Layout from '@layouts/Layout.astro';
import { db, schema } from '@lib/db';
import { readdirSync } from 'node:fs';
import { join, extname } from 'node:path';

const IMAGE_DIR = './data/images';

function listImages() {
    try {
        const files = readdirSync(IMAGE_DIR);
        return files.map(name => {
            const dot = name.lastIndexOf('.');
            const sha256 = dot > 0 ? name.slice(0, dot) : name;
            return { name, sha256, ext: dot > 0 ? name.slice(dot) : '' };
        });
    } catch {
        return [];
    }
}

const files = listImages();
const descRows = await db.select().from(schema.images);
const descMap = new Map(descRows.map(r => [r.sha256, r.description]));
---

<Layout title="图片管理">
    <h1>图片管理 <span class="meta">({files.length} 张)</span></h1>

    <form method="POST" action="/api/images/delete-descriptions" id="batch">
        <div class="grid">
            {files.map(f => {
                const desc = descMap.get(f.sha256);
                return (
                    <div class="card">
                        <img src={`/api/images/file/${f.name}`} alt={f.sha256} loading="lazy" />
                        <div class="info">
                            <div class="sha">{f.sha256.slice(0, 16)}…</div>
                            <div class={`desc ${desc ? '' : 'empty'}`}>{desc ?? '（无描述）'}</div>
                        </div>
                        <label class="check">
                            <input type="checkbox" name="sha256" value={f.sha256} /> 选择
                        </label>
                    </div>
                );
            })}
            {files.length === 0 && <p class="empty">暂无图片</p>}
        </div>

        <div class="toolbar">
            <button type="submit" class="btn btn-secondary btn-sm">🗑️ 删除选中描述</button>
        </div>
    </form>

    <form method="POST" action="/api/images/clear-all" class="danger-zone"
        onsubmit="return confirm('确定清空全部图片描述？')"
    >
        <button type="submit" class="btn btn-danger btn-sm">⚠️ 全部清空描述</button>
    </form>
</Layout>

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
    }
    .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: background 0.15s;
    }
    .card:hover { background: var(--surface-hover); }
    .card img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border-bottom: 1px solid var(--border);
    }
    .info { padding: 12px; flex: 1; }
    .sha {
        font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
        font-size: 12px;
        color: var(--text-secondary);
        margin-bottom: 6px;
        word-break: break-all;
    }
    .desc {
        font-size: 13px;
        color: var(--text);
        line-height: 1.5;
    }
    .desc.empty { color: var(--text-secondary); font-style: italic; }
    .check {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 10px 12px;
        border-top: 1px solid var(--border);
        font-size: 13px;
        color: var(--text-secondary);
        cursor: pointer;
    }
    .check input { accent-color: var(--accent); }
    .empty { grid-column: 1 / -1; color: var(--text-secondary); text-align: center; padding: 40px; }
    .danger-zone {
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
    }
</style>
