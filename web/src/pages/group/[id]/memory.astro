---
import Layout from '@layouts/Layout.astro';
import GroupLabel from '../../../components/GroupLabel.astro';
import {formatGroupTitle} from '@lib/group-display';
import {db} from '@lib/db';
import {getGroupOverallMemoryRecord} from '~/db';
import {formatDateTime} from '@lib/format-date';

const groupId = Number(Astro.params.id);
if (!groupId || isNaN(groupId)) {
    return new Response('Invalid group ID', {status: 400});
}

const memory = await getGroupOverallMemoryRecord(db, groupId);
---

<Layout title={formatGroupTitle(groupId, '总体记忆')}>
    <div class="memory-page" data-group-id={groupId}>
        <h1>
            <a href={`/group/${groupId}`}>← 消息列表</a> · <GroupLabel groupId={groupId} /> 总体记忆
        </h1>
        <section class="memory-card">
            <div class="memory-meta">
                {memory ? `更新于 ${formatDateTime(memory.updatedAt?.toISOString())}` : '暂无总体记忆，填写内容并保存即可添加。'}
            </div>
            <textarea id="memory-content" class="memory-editor" rows="18" spellcheck="false">{memory?.content ?? ''}</textarea>
            <div class="memory-actions">
                <button id="save-memory-btn" class="btn" type="button">{memory ? '保存修改' : '添加总体记忆'}</button>
                {memory && <button id="delete-memory-btn" class="btn btn-danger" type="button">删除总体记忆</button>}
            </div>
        </section>
    </div>
</Layout>

<style>
    .memory-card {
        padding: 20px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
    }
    .memory-meta {
        margin-bottom: 16px;
        color: var(--text-secondary);
        font-size: 13px;
    }
    .memory-editor {
        width: 100%;
        margin-bottom: 16px;
        padding: 12px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        color: var(--text);
        font-family: inherit;
        font-size: 14px;
        line-height: 1.8;
        resize: vertical;
    }
    .memory-actions {
        display: flex;
        gap: 12px;
    }
</style>

<script>
    const root = document.querySelector<HTMLElement>('.memory-page');
    const contentInput = document.querySelector<HTMLTextAreaElement>('#memory-content');
    const saveButton = document.querySelector<HTMLButtonElement>('#save-memory-btn');
    const deleteButton = document.querySelector<HTMLButtonElement>('#delete-memory-btn');
    const saveDefaultText = saveButton?.textContent ?? '保存';
    saveButton?.addEventListener('click', async () => {
        const groupId = Number(root?.dataset.groupId);
        if (!groupId) throw new Error('group id not found');
        const content = contentInput?.value.trim() ?? '';
        if (!content) {
            alert('总体记忆内容不能为空');
            return;
        }
        saveButton.disabled = true;
        saveButton.textContent = '保存中...';
        try {
            const response = await fetch(`/api/group/${groupId}/memory`, {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({content})
            });
            const data = await response.json();
            if (!response.ok || !data.success) {
                throw new Error(data.error || '未知错误');
            }
            location.reload();
        } catch (error) {
            alert(`保存失败：${error instanceof Error ? error.message : String(error)}`);
            saveButton.disabled = false;
            saveButton.textContent = saveDefaultText;
        }
    });
    deleteButton?.addEventListener('click', async () => {
        const groupId = Number(root?.dataset.groupId);
        if (!groupId) throw new Error('group id not found');
        if (!confirm('确定删除该群的总体记忆吗？当前会话将更换为不含总体记忆的新会话。')) return;
        deleteButton.disabled = true;
        deleteButton.textContent = '删除中...';
        try {
            const response = await fetch(`/api/group/${groupId}/memory`, {
                method: 'DELETE',
                headers: {'Content-Type': 'application/json'}
            });
            const data = await response.json();
            if (!response.ok || !data.success) {
                throw new Error(data.error || '未知错误');
            }
            location.reload();
        } catch (error) {
            alert(`删除失败：${error instanceof Error ? error.message : String(error)}`);
            deleteButton.disabled = false;
            deleteButton.textContent = '删除总体记忆';
        }
    });
</script>
