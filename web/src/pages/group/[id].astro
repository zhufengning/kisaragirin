---
import Layout from '@layouts/Layout.astro';
import { formatSender } from '~/message-format';
import {
    buildPageUrl,
    buildSearchUrl,
    buildSortUrl,
    loadMessagesPageData
} from '@lib/messages-query';
import {
    formatPreview,
    formatSenderCell,
    formatTime,
    typeBadgeClass,
    typeLabel
} from '@lib/messages-render';
import '../../styles/messages.css';

const groupId = Number(Astro.params.id);
if (!groupId || isNaN(groupId)) {
    return new Response('Invalid group ID', { status: 400 });
}

const { messages, totalCount, totalPages, validPage, searchQuery, sortDesc } =
    await loadMessagesPageData(Astro.url, groupId);

function sortUrl(): string {
    return buildSortUrl(Astro.url, sortDesc);
}

function pageUrl(page: number): string {
    return buildPageUrl(Astro.url, page);
}

function searchUrl(search: string): string {
    return buildSearchUrl(Astro.url, search);
}

const sortIndicator = sortDesc ? '▼' : '▲';
const sortTitle = sortDesc ? '当前：新消息在前，点击改为旧消息在前' : '当前：旧消息在前，点击改为新消息在前';
---

<Layout title={`群 ${groupId} 消息`}>
    <h1>
        <a href="/">← 群列表</a> · 群 {groupId}
        <span class="meta">({totalCount} 条消息{searchQuery ? ` · 搜索: "${searchQuery}"` : ''})</span>
        · <a href={`/group/${groupId}/preview`} class="preview-link">预览 Prompt →</a>
        · <a href={`/group/${groupId}/harness`} class="preview-link">Harness 日志 →</a>
    </h1>

    <!-- 工具栏 -->
    <div class="toolbar">
        <form class="search-bar" method="GET" action={Astro.url.pathname}>
            <input
                type="text"
                name="search"
                value={searchQuery}
                placeholder="搜索发送者或消息内容..."
                class="search-input"
            />
            <button type="submit" class="btn btn-sm">🔍 搜索</button>
            {searchQuery && (
                <a href={searchUrl('')} class="btn btn-secondary btn-sm">清除</a>
            )}
        </form>

        <div class="actions">
            <div class="import-box">
                <input type="date" id="import-start" class="date-input" title="开始日期" />
                <input type="date" id="import-end" class="date-input" title="结束日期" />
                <button id="import-btn" class="btn btn-secondary btn-sm">导入历史</button>
            </div>
            <button id="compact-btn" class="btn btn-secondary btn-sm">手动 Compact</button>
            <button id="clear-btn" class="btn btn-danger btn-sm">清空全部</button>
            <button id="batch-delete-btn" class="btn btn-danger btn-sm" disabled>批量删除</button>
        </div>
    </div>

    <!-- 消息表格 -->
    <div class="table-wrap" data-group-id={groupId}>
        <table class="message-table">
            <thead>
                <tr>
                    <th class="col-check">
                        <input type="checkbox" id="select-all" title="全选" />
                    </th>
                    <th class="col-id">
                        <a href={sortUrl()} class="sort-header" title={sortTitle}>
                            ID {sortIndicator}
                        </a>
                    </th>
                    <th class="col-time">时间</th>
                    <th class="col-sender">发送者</th>
                    <th class="col-type">类型</th>
                    <th class="col-preview">消息预览</th>
                    <th class="col-actions">操作</th>
                </tr>
            </thead>
            <tbody>
                {messages.map(msg => {
                    const sender = formatSenderCell(msg);
                    return (
                        <tr class="message-row" data-id={msg.id} data-time={formatTime(msg.time)} data-sender={formatSender(msg)} data-type={msg.specialType} data-preview={formatPreview(msg)} data-segments={JSON.stringify(msg.segments)} data-images={JSON.stringify(msg.images)}>
                            <td class="col-check">
                                <input type="checkbox" class="row-checkbox" value={msg.id} />
                            </td>
                            <td class="col-id">{msg.id}</td>
                            <td class="col-time">{formatTime(msg.time)}</td>
                            <td class="col-sender">
                                <div class="sender-name">{sender.name}</div>
                                {sender.idLabel && <div class="sender-id">{sender.idLabel}</div>}
                            </td>
                            <td class="col-type">
                                <span class={typeBadgeClass(msg.specialType)}>{typeLabel(msg.specialType)}</span>
                            </td>
                            <td class="col-preview">{formatPreview(msg)}</td>
                            <td class="col-actions">
                                <button type="button" class="btn btn-sm btn-secondary detail-btn" data-id={msg.id}>详情</button>
                                <button type="button" class="btn btn-sm btn-danger delete-btn" data-id={msg.id}>删除</button>
                            </td>
                        </tr>
                    );
                })}
            </tbody>
        </table>
        {messages.length === 0 && (
            <p class="empty">{searchQuery ? '没有找到匹配的消息' : '暂无消息'}</p>
        )}
    </div>

    <!-- 分页导航 -->
    {totalPages > 1 && (
        <nav class="pagination">
            <a
                href={pageUrl(validPage - 1)}
                class={`page-btn ${validPage <= 1 ? 'disabled' : ''}`}
                aria-disabled={validPage <= 1}
            >
                ← 上一页
            </a>
            <span class="page-info">
                第 {validPage} / {totalPages} 页 · 共 {totalCount} 条
            </span>
            <a
                href={pageUrl(validPage + 1)}
                class={`page-btn ${validPage >= totalPages ? 'disabled' : ''}`}
                aria-disabled={validPage >= totalPages}
            >
                下一页 →
            </a>
        </nav>
    )}

    <!-- 详情弹窗 -->
    <div id="detail-modal" class="modal hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modal-title">消息详情</h3>
                <button type="button" class="modal-close" id="modal-close">×</button>
            </div>
            <div class="modal-body">
                <div class="detail-field">
                    <span class="detail-label">ID</span>
                    <span id="modal-id" class="detail-value"></span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">时间</span>
                    <span id="modal-time" class="detail-value"></span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">发送者</span>
                    <span id="modal-sender" class="detail-value"></span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">类型</span>
                    <span id="modal-type" class="detail-value"></span>
                </div>
                <div class="detail-field detail-stack">
                    <span class="detail-label">完整内容</span>
                    <pre id="modal-preview" class="detail-preview"></pre>
                </div>
                <div class="detail-field detail-stack" id="modal-images-field" style="display: none;">
                    <span class="detail-label">图片描述</span>
                    <pre id="modal-images" class="detail-preview"></pre>
                </div>
                <div class="detail-field detail-stack">
                    <span class="detail-label">原始 Segments (JSON)</span>
                    <pre id="modal-segments" class="detail-json"></pre>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="modal-close-btn">关闭</button>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { initMessagesPage } from '@lib/messages-client';

    initMessagesPage();
</script>
