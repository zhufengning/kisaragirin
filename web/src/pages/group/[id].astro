---
import Layout from '@layouts/Layout.astro';
import { db, schema } from '@lib/db';
import { eq, inArray, sql } from 'drizzle-orm';
import type { StoredMessage } from '../../../../src/message-format';
import { messagesToString } from '../../../../src/message-format';

const groupId = Number(Astro.params.id);
if (!groupId || isNaN(groupId)) {
    return new Response('Invalid group ID', { status: 400 });
}

const PAGE_SIZE = 50;
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));

// 先获取总消息数
const countResult = await db
    .select({ count: sql<number>`count(*)` })
    .from(schema.messages)
    .where(eq(schema.messages.groupId, groupId));
const totalCount = countResult[0]?.count || 0;
const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
const validPage = Math.min(currentPage, totalPages);

// 分页查询消息
const rows = await db
    .select()
    .from(schema.messages)
    .where(eq(schema.messages.groupId, groupId))
    .orderBy(sql`${schema.messages.time} DESC`)
    .limit(PAGE_SIZE)
    .offset((validPage - 1) * PAGE_SIZE);

// 反转回时间正序显示
rows.reverse();

const messages: StoredMessage[] = rows.map(r => ({
    time: r.time,
    messageId: r.messageId,
    senderId: r.userId,
    senderName: r.senderName,
    senderCard: r.senderCard,
    isBot: r.isBot,
    isAtBot: r.isAtBot,
    segments: r.segments as StoredMessage['segments'],
}));

// 批量查询图片描述
const shaSet = new Set<string>();
for (const msg of messages) {
    for (const seg of msg.segments) {
        if (seg.type === 'image') shaSet.add(seg.sha256);
    }
}
const imageRows = shaSet.size > 0
    ? await db.select().from(schema.images).where(inArray(schema.images.sha256, Array.from(shaSet)))
    : [];
const descMap = new Map(imageRows.map(r => [r.sha256, r.description]));

async function resolveDesc(sha256: string): Promise<string | undefined> {
    return descMap.get(sha256);
}

const text = await messagesToString(messages, resolveDesc);

// 构建分页URL
function pageUrl(page: number) {
    const url = new URL(Astro.url);
    url.searchParams.set('page', String(page));
    return url.pathname + url.search;
}
---

<Layout title={`群 ${groupId} 消息`}>
    <h1><a href="/">← 群列表</a> · 群 {groupId} <span class="meta">({totalCount} 条消息)</span></h1>

    <pre class="messages">{text}</pre>
    {messages.length === 0 && <p class="empty">暂无消息</p>}

    <!-- 分页导航 -->
    {totalPages > 1 && (
        <nav class="pagination">
            <a
                href={pageUrl(validPage - 1)}
                class={`page-btn ${validPage <= 1 ? 'disabled' : ''}`}
                aria-disabled={validPage <= 1}
            >
                ← 上一页
            </a>
            <span class="page-info">
                第 {validPage} / {totalPages} 页 · 共 {totalCount} 条
            </span>
            <a
                href={pageUrl(validPage + 1)}
                class={`page-btn ${validPage >= totalPages ? 'disabled' : ''}`}
                aria-disabled={validPage >= totalPages}
            >
                下一页 →
            </a>
        </nav>
    )}
</Layout>

<style>
    .messages {
        font-size: 14px;
        line-height: 1.7;
        word-break: break-word;
        white-space: pre-wrap;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 14px 18px;
    }
    .empty { color: var(--text-secondary); text-align: center; padding: 40px; }
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
        padding: 16px;
    }
    .page-btn {
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        font-size: 14px;
        text-decoration: none;
        transition: background 0.15s;
    }
    .page-btn:hover:not(.disabled) {
        background: var(--surface-hover);
        text-decoration: none;
    }
    .page-btn.disabled {
        opacity: 0.4;
        cursor: not-allowed;
        pointer-events: none;
    }
    .page-info {
        font-size: 14px;
        color: var(--text-secondary);
    }
</style>


