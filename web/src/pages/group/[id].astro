---
import Layout from '@layouts/Layout.astro';
import { db, schema } from '@lib/db';
import { eq, and, or, like, sql } from 'drizzle-orm';
import type { StoredMessage, StoredSegment } from '../../../../src/message-format';

const groupId = Number(Astro.params.id);
if (!groupId || isNaN(groupId)) {
    return new Response('Invalid group ID', { status: 400 });
}

const PAGE_SIZE = 50;
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const searchQuery = Astro.url.searchParams.get('search')?.trim() || '';
const sortDirParam = Astro.url.searchParams.get('sort')?.toLowerCase();
const sortDesc = sortDirParam === 'asc' ? false : true; // 默认新在前（降序）

// 搜索条件：发送者名称/名片、原始消息文本、segments JSON
const baseCondition = eq(schema.messages.groupId, groupId);
let whereClause = baseCondition;

if (searchQuery) {
    const searchPattern = `%${searchQuery}%`;
    whereClause = and(
        baseCondition,
        or(
            like(schema.messages.senderName, searchPattern),
            like(schema.messages.senderCard, searchPattern),
            like(schema.messages.rawMessage, searchPattern),
            sql`json_extract(${schema.messages.segments}, '$') LIKE ${searchPattern}`
        )
    ) ?? baseCondition;
}

// 总消息数
const countResult = await db
    .select({ count: sql<number>`count(*)` })
    .from(schema.messages)
    .where(whereClause);
const totalCount = countResult[0]?.count || 0;
const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
const validPage = Math.min(currentPage, totalPages);

// 分页查询消息，默认按 ID 降序（新消息在前），方向可通过 sort 参数切换
const orderColumn = schema.messages.id;
const rows = await db
    .select()
    .from(schema.messages)
    .where(whereClause)
    .orderBy(sql`${orderColumn} ${sortDesc ? sql`DESC` : sql`ASC`}`)
    .limit(PAGE_SIZE)
    .offset((validPage - 1) * PAGE_SIZE);

const messages = rows.map(r => ({
    id: r.id,
    time: r.time,
    messageId: r.messageId,
    senderId: r.userId,
    senderName: r.senderName,
    senderCard: r.senderCard ?? undefined,
    isBot: r.isBot,
    isAtBot: r.isAtBot,
    segments: r.segments as StoredMessage['segments'],
    specialType: r.specialType,
}));

// 收集本页消息中所有图片 sha256（含 reply/forward 嵌套），批量查询图片描述
function collectSha256(segments: StoredSegment[], shaSet: Set<string>): void {
    for (const seg of segments) {
        if (seg.type === 'image') {
            shaSet.add(seg.sha256);
        } else if (seg.type === 'reply' && seg.message) {
            collectSha256(seg.message.segments, shaSet);
        } else if (seg.type === 'forward' && seg.messages) {
            for (const m of seg.messages) collectSha256(m.segments, shaSet);
        }
    }
}

const pageShaSet = new Set<string>();
for (const msg of messages) collectSha256(msg.segments, pageShaSet);
const pageShaList = Array.from(pageShaSet);
const imageDescRows = pageShaList.length > 0
    ? await db.select().from(schema.images).where(sql`${schema.images.sha256} IN ${pageShaList}`)
    : [];
const imageDescMap = new Map(imageDescRows.map(r => [r.sha256, r.description]));

type MessageItem = typeof messages[number];

interface MessageImageInfo {
    sha256: string;
    description: string | null;
}

/** 提取消息中的图片列表（含 reply/forward 嵌套），按出现顺序去重 */
function collectImages(segments: StoredSegment[], images: MessageImageInfo[], seen: Set<string>): void {
    for (const seg of segments) {
        if (seg.type === 'image') {
            if (!seen.has(seg.sha256)) {
                seen.add(seg.sha256);
                images.push({ sha256: seg.sha256, description: imageDescMap.get(seg.sha256) ?? null });
            }
        } else if (seg.type === 'reply' && seg.message) {
            collectImages(seg.message.segments, images, seen);
        } else if (seg.type === 'forward' && seg.messages) {
            for (const m of seg.messages) collectImages(m.segments, images, seen);
        }
    }
}

function messageImages(msg: MessageItem): MessageImageInfo[] {
    const images: MessageImageInfo[] = [];
    collectImages(msg.segments, images, new Set());
    return images;
}

function formatSender(msg: StoredMessage): string {
    const id = msg.senderId;
    const name = msg.senderCard || msg.senderName || '';
    if (id == null) return 'unknown';
    if (!name) return `(${id})`;
    if (msg.isBot) return `${name}(me)(${id})`;
    return `${name}(${id})`;
}

function segmentToRaw(seg: StoredSegment): string {
    switch (seg.type) {
        case 'text': return seg.text;
        case 'at': return `@${seg.targetName || seg.target}`;
        case 'image': return `[image:${seg.sha256.slice(0, 16)}...]`;
        case 'face': return `[face:${seg.name || seg.id}]`;
        case 'record': return '[record:语音]';
        case 'video': return `[video:${seg.fileName || '未知'}]`;
        case 'file': return `[file:${seg.fileName}]`;
        case 'json': return `[json:${seg.data ?? '未知json'}]`;
        case 'poke': return `[poke:${seg.pokeType},${seg.id}]`;
        case 'dice': return `[dice:${seg.result ?? '?'}]`;
        case 'rps': return `[rps:${seg.result ?? '?'}]`;
        case 'reply': return `[reply:${seg.id}]`;
        case 'forward': return `[forward:${seg.id}]`;
        case 'compact': return `**前情提要**: ${seg.text}`;
        case 'system': return `**系统消息**: ${seg.text}`;
        default: return `[${(seg as { type: string }).type}]`;
    }
}

function formatMessageRaw(msg: StoredMessage): string {
    const isSpecial = msg.segments.length === 1 &&
        (msg.segments[0].type === 'compact' || msg.segments[0].type === 'system');
    if (isSpecial) {
        return msg.segments.map(segmentToRaw).join('');
    }
    const atMark = msg.isAtBot ? '(有人@我) ' : '';
    const sender = formatSender(msg);
    const body = msg.segments.map(segmentToRaw).join('');
    return `${atMark}[${sender}]: ${body}`;
}

function formatPreview(msg: MessageItem): string {
    const raw = formatMessageRaw(msg);
    return raw.length > 120 ? `${raw.slice(0, 120)}…` : raw;
}

function formatTime(timestamp: number): string {
    const d = new Date(timestamp * 1000);
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
}

function formatSenderCell(msg: MessageItem): { name: string; idLabel: string } {
    const id = msg.senderId;
    const name = msg.senderCard || msg.senderName || '';
    if (id == null) return { name: 'unknown', idLabel: '' };
    if (!name) return { name: `(${id})`, idLabel: '' };
    return {
        name: msg.isBot ? `${name}(me)` : name,
        idLabel: String(id)
    };
}

function typeBadgeClass(type: string): string {
    switch (type) {
        case 'compact': return 'type-badge type-compact';
        case 'system': return 'type-badge type-system';
        default: return 'type-badge type-normal';
    }
}

function typeLabel(type: string): string {
    switch (type) {
        case 'compact': return 'compact';
        case 'system': return 'system';
        default: return 'normal';
    }
}

function sortUrl() {
    const url = new URL(Astro.url);
    url.searchParams.delete('page');
    if (sortDesc) {
        url.searchParams.set('sort', 'asc');
    } else {
        url.searchParams.delete('sort');
    }
    return url.pathname + url.search;
}

function pageUrl(page: number) {
    const url = new URL(Astro.url);
    url.searchParams.set('page', String(page));
    return url.pathname + url.search;
}

function searchUrl(search: string) {
    const url = new URL(Astro.url);
    url.searchParams.delete('page');
    if (search) {
        url.searchParams.set('search', search);
    } else {
        url.searchParams.delete('search');
    }
    return url.pathname + url.search;
}

const sortIndicator = sortDesc ? '▼' : '▲';
const sortTitle = sortDesc ? '当前：新消息在前，点击改为旧消息在前' : '当前：旧消息在前，点击改为新消息在前';
---

<Layout title={`群 ${groupId} 消息`}>
    <h1>
        <a href="/">← 群列表</a> · 群 {groupId}
        <span class="meta">({totalCount} 条消息{searchQuery ? ` · 搜索: "${searchQuery}"` : ''})</span>
        · <a href={`/group/${groupId}/preview`} class="preview-link">预览 Prompt →</a>
        · <a href={`/group/${groupId}/harness`} class="preview-link">Harness 日志 →</a>
    </h1>

    <!-- 工具栏 -->
    <div class="toolbar">
        <form class="search-bar" method="GET" action={Astro.url.pathname}>
            <input
                type="text"
                name="search"
                value={searchQuery}
                placeholder="搜索发送者或消息内容..."
                class="search-input"
            />
            <button type="submit" class="btn btn-sm">🔍 搜索</button>
            {searchQuery && (
                <a href={searchUrl('')} class="btn btn-secondary btn-sm">清除</a>
            )}
        </form>

        <div class="actions">
            <div class="import-box">
                <input type="date" id="import-start" class="date-input" title="开始日期" />
                <input type="date" id="import-end" class="date-input" title="结束日期" />
                <button id="import-btn" class="btn btn-secondary btn-sm">导入历史</button>
            </div>
            <button id="compact-btn" class="btn btn-secondary btn-sm">手动 Compact</button>
            <button id="clear-btn" class="btn btn-danger btn-sm">清空全部</button>
            <button id="batch-delete-btn" class="btn btn-danger btn-sm" disabled>批量删除</button>
        </div>
    </div>

    <!-- 消息表格 -->
    <div class="table-wrap">
        <table class="message-table">
            <thead>
                <tr>
                    <th class="col-check">
                        <input type="checkbox" id="select-all" title="全选" />
                    </th>
                    <th class="col-id">
                        <a href={sortUrl()} class="sort-header" title={sortTitle}>
                            ID {sortIndicator}
                        </a>
                    </th>
                    <th class="col-time">时间</th>
                    <th class="col-sender">发送者</th>
                    <th class="col-type">类型</th>
                    <th class="col-preview">消息预览</th>
                    <th class="col-actions">操作</th>
                </tr>
            </thead>
            <tbody>
                {messages.map(msg => {
                    const sender = formatSenderCell(msg);
                    return (
                        <tr class="message-row" data-id={msg.id} data-time={formatTime(msg.time)} data-sender={formatSender(msg)} data-type={msg.specialType} data-preview={formatPreview(msg)} data-segments={JSON.stringify(msg.segments)} data-images={JSON.stringify(messageImages(msg))}>
                            <td class="col-check">
                                <input type="checkbox" class="row-checkbox" value={msg.id} />
                            </td>
                            <td class="col-id">{msg.id}</td>
                            <td class="col-time">{formatTime(msg.time)}</td>
                            <td class="col-sender">
                                <div class="sender-name">{sender.name}</div>
                                {sender.idLabel && <div class="sender-id">{sender.idLabel}</div>}
                            </td>
                            <td class="col-type">
                                <span class={typeBadgeClass(msg.specialType)}>{typeLabel(msg.specialType)}</span>
                            </td>
                            <td class="col-preview">{formatPreview(msg)}</td>
                            <td class="col-actions">
                                <button type="button" class="btn btn-sm btn-secondary detail-btn" data-id={msg.id}>详情</button>
                                <button type="button" class="btn btn-sm btn-danger delete-btn" data-id={msg.id}>删除</button>
                            </td>
                        </tr>
                    );
                })}
            </tbody>
        </table>
        {messages.length === 0 && (
            <p class="empty">{searchQuery ? '没有找到匹配的消息' : '暂无消息'}</p>
        )}
    </div>

    <!-- 分页导航 -->
    {totalPages > 1 && (
        <nav class="pagination">
            <a
                href={pageUrl(validPage - 1)}
                class={`page-btn ${validPage <= 1 ? 'disabled' : ''}`}
                aria-disabled={validPage <= 1}
            >
                ← 上一页
            </a>
            <span class="page-info">
                第 {validPage} / {totalPages} 页 · 共 {totalCount} 条
            </span>
            <a
                href={pageUrl(validPage + 1)}
                class={`page-btn ${validPage >= totalPages ? 'disabled' : ''}`}
                aria-disabled={validPage >= totalPages}
            >
                下一页 →
            </a>
        </nav>
    )}

    <!-- 详情弹窗 -->
    <div id="detail-modal" class="modal hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modal-title">消息详情</h3>
                <button type="button" class="modal-close" id="modal-close">×</button>
            </div>
            <div class="modal-body">
                <div class="detail-field">
                    <span class="detail-label">ID</span>
                    <span id="modal-id" class="detail-value"></span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">时间</span>
                    <span id="modal-time" class="detail-value"></span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">发送者</span>
                    <span id="modal-sender" class="detail-value"></span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">类型</span>
                    <span id="modal-type" class="detail-value"></span>
                </div>
                <div class="detail-field detail-stack">
                    <span class="detail-label">完整内容</span>
                    <pre id="modal-preview" class="detail-preview"></pre>
                </div>
                <div class="detail-field detail-stack" id="modal-images-field" style="display: none;">
                    <span class="detail-label">图片描述</span>
                    <pre id="modal-images" class="detail-preview"></pre>
                </div>
                <div class="detail-field detail-stack">
                    <span class="detail-label">原始 Segments (JSON)</span>
                    <pre id="modal-segments" class="detail-json"></pre>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="modal-close-btn">关闭</button>
            </div>
        </div>
    </div>
</Layout>

<script is:inline define:vars={{ groupId }}>
    const importStart = document.getElementById('import-start');
    const importEnd = document.getElementById('import-end');
    const importBtn = document.getElementById('import-btn');

    function formatDate(d) {
        const pad = (n) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    }

    if (importStart && importEnd) {
        const today = new Date();
        const weekAgo = new Date();
        weekAgo.setDate(today.getDate() - 7);
        importStart.value = formatDate(weekAgo);
        importEnd.value = formatDate(today);
    }

    importBtn?.addEventListener('click', async () => {
        const start = importStart?.value;
        const end = importEnd?.value;
        if (!start || !end) {
            alert('请选择开始和结束日期');
            return;
        }
        if (start > end) {
            alert('开始日期不能晚于结束日期');
            return;
        }
        if (!confirm(`确定导入 ${start} 至 ${end} 的历史消息到会话吗？（忽略压缩消息）`)) return;
        importBtn.disabled = true;
        importBtn.textContent = '导入中...';
        try {
            const res = await fetch(`/api/group/${groupId}/import`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ startDate: start, endDate: end }),
            });
            const data = await res.json();
            if (data.success) {
                alert(`已导入 ${data.imported} 条消息`);
            } else {
                alert('导入失败：' + (data.error || '未知错误'));
            }
        } catch (err) {
            alert('导入失败：' + err.message);
        } finally {
            importBtn.disabled = false;
            importBtn.textContent = '导入历史';
        }
    });

    const compactBtn = document.getElementById('compact-btn');
    compactBtn?.addEventListener('click', async () => {
        if (!confirm('确定要手动触发 compact 吗？这将把旧消息摘要成一条「前情提要」消息。')) return;
        compactBtn.disabled = true;
        compactBtn.textContent = 'Compacting...';
        try {
            const res = await fetch(`/api/compact?groupId=${groupId}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                alert(data.compacted ? 'Compact 成功！' : '无需 compact');
                location.reload();
            } else {
                alert('Compact 失败：' + (data.error || '未知错误'));
            }
        } catch (err) {
            alert('Compact 失败：' + err.message);
        } finally {
            compactBtn.disabled = false;
            compactBtn.textContent = '手动 Compact';
        }
    });

    const clearBtn = document.getElementById('clear-btn');
    clearBtn?.addEventListener('click', async () => {
        if (!confirm(`确定要清空群 ${groupId} 的所有消息吗？此操作不可恢复。`)) return;
        clearBtn.disabled = true;
        clearBtn.textContent = '清空中...';
        try {
            const res = await fetch(`/api/group/${groupId}/clear`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                alert('已清空所有消息');
                location.reload();
            } else {
                alert('清空失败：' + (data.error || '未知错误'));
            }
        } catch (err) {
            alert('清空失败：' + err.message);
        } finally {
            clearBtn.disabled = false;
            clearBtn.textContent = '清空全部';
        }
    });

    async function deleteMessageIds(ids) {
        if (ids.length === 0) return;
        const noun = ids.length === 1 ? '这条消息' : `${ids.length} 条消息`;
        if (!confirm(`确定要删除 ${noun} 吗？此操作不可恢复。`)) return;
        try {
            const res = await fetch('/api/messages/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids }),
            });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert('删除失败：' + (data.error || '未知错误'));
            }
        } catch (err) {
            alert('删除失败：' + err.message);
        }
    }

    const selectAll = document.getElementById('select-all');
    const rowCheckboxes = document.querySelectorAll('.row-checkbox');
    const batchDeleteBtn = document.getElementById('batch-delete-btn');

    function updateBatchButton() {
        const checked = document.querySelectorAll('.row-checkbox:checked');
        if (batchDeleteBtn) {
            batchDeleteBtn.disabled = checked.length === 0;
            batchDeleteBtn.textContent = checked.length > 0 ? `批量删除 (${checked.length})` : '批量删除';
        }
    }

    selectAll?.addEventListener('change', () => {
        const checked = selectAll.checked;
        rowCheckboxes.forEach(cb => { cb.checked = checked; });
        updateBatchButton();
    });

    rowCheckboxes.forEach(cb => {
        cb.addEventListener('change', updateBatchButton);
    });

    batchDeleteBtn?.addEventListener('click', () => {
        const checked = Array.from(document.querySelectorAll('.row-checkbox:checked'));
        const ids = checked.map(cb => Number(cb.value));
        void deleteMessageIds(ids);
    });

    document.querySelector('.message-table')?.addEventListener('click', (e) => {
        const target = e.target;
        const deleteBtn = target.closest('.delete-btn');
        if (deleteBtn) {
            const id = Number(deleteBtn.dataset.id);
            void deleteMessageIds([id]);
            return;
        }

        const detailBtn = target.closest('.detail-btn');
        if (detailBtn) {
            const row = detailBtn.closest('.message-row');
            openDetailModal(row);
            return;
        }

        const row = target.closest('.message-row');
        if (row && !target.closest('input, button')) {
            openDetailModal(row);
        }
    });

    const detailModal = document.getElementById('detail-modal');
    const modalClose = document.getElementById('modal-close');
    const modalCloseBtn = document.getElementById('modal-close-btn');

    function closeDetailModal() {
        detailModal?.classList.add('hidden');
    }

    function openDetailModal(row) {
        if (!row || !detailModal) return;
        document.getElementById('modal-title').textContent = `消息详情 #${row.dataset.id}`;
        document.getElementById('modal-id').textContent = row.dataset.id;
        document.getElementById('modal-time').textContent = row.dataset.time;
        document.getElementById('modal-sender').textContent = row.dataset.sender;
        document.getElementById('modal-type').textContent = row.dataset.type;
        document.getElementById('modal-preview').textContent = row.dataset.preview;

        let segmentsText = row.dataset.segments;
        try {
            segmentsText = JSON.stringify(JSON.parse(segmentsText), null, 2);
        } catch {
            // 保持原样
        }
        document.getElementById('modal-segments').textContent = segmentsText;

        const imagesField = document.getElementById('modal-images-field');
        const imagesContainer = document.getElementById('modal-images');
        if (imagesField && imagesContainer) {
            let images = [];
            try {
                images = JSON.parse(row.dataset.images || '[]');
            } catch {
                images = [];
            }
            imagesField.style.display = images.length > 0 ? '' : 'none';
            imagesContainer.textContent = images
                .map(img => `${img.sha256}\n${img.description || '（无描述）'}`)
                .join('\n\n');
        }

        detailModal.classList.remove('hidden');
    }

    modalClose?.addEventListener('click', closeDetailModal);
    modalCloseBtn?.addEventListener('click', closeDetailModal);
    detailModal?.addEventListener('click', (e) => {
        if (e.target === detailModal) closeDetailModal();
    });
</script>

<style>
    .preview-link {
        font-size: 14px;
        color: var(--accent);
        text-decoration: none;
    }
    .preview-link:hover {
        text-decoration: underline;
    }
    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }
    .search-bar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        flex: 1;
        min-width: 260px;
    }
    .search-input {
        flex: 1;
        min-width: 200px;
        padding: 8px 14px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        font-size: 14px;
        font-family: inherit;
    }
    .search-input:focus {
        outline: none;
        border-color: var(--accent);
    }
    .search-input::placeholder {
        color: var(--text-secondary);
    }
    .actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .import-box {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .date-input {
        padding: 8px 14px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        font-size: 14px;
        font-family: inherit;
    }
    .date-input:focus {
        outline: none;
        border-color: var(--accent);
    }
