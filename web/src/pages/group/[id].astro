---
import Layout from '@layouts/Layout.astro';
import { db, schema } from '@lib/db';
import { eq } from 'drizzle-orm';
import type { StoredSegment } from '../../../../src/message-format';
import { getQueue } from '@lib/queue';

const groupId = Number(Astro.params.id);
if (!groupId || isNaN(groupId)) {
    return new Response('Invalid group ID', { status: 400 });
}

const rows = await db
    .select()
    .from(schema.messages)
    .where(eq(schema.messages.groupId, groupId))
    .orderBy(schema.messages.time);

const queue = getQueue();

interface RenderedMessage {
    time: number;
    senderName: string;
    senderCard: string | null;
    isBot: boolean;
    segments: StoredSegment[];
}

const messages: RenderedMessage[] = rows.map(r => ({
    time: r.time,
    senderName: r.senderName,
    senderCard: r.senderCard,
    isBot: r.isBot,
    segments: r.segments as StoredSegment[],
}));

async function resolveDesc(sha256: string): Promise<string | undefined> {
    return queue.resolve(sha256);
}

const descCache = new Map<string, string | undefined>();
async function getDesc(sha256: string): Promise<string | undefined> {
    if (descCache.has(sha256)) return descCache.get(sha256);
    const d = await resolveDesc(sha256);
    descCache.set(sha256, d);
    return d;
}

for (const msg of messages) {
    for (const seg of msg.segments) {
        if (seg.type === 'image') {
            await getDesc(seg.sha256);
        }
    }
}

function fmtTime(ts: number): string {
    const d = new Date(ts * 1000);
    return d.toLocaleString('zh-CN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
}

function senderLabel(m: RenderedMessage): string {
    if (m.senderCard) return `${m.senderName} (${m.senderCard})`;
    return m.senderName;
}
---

<Layout title={`群 ${groupId} 消息`}>
    <h1><a href="/">← 群列表</a> · 群 {groupId}</h1>
    <div class="messages">
        {messages.map(msg => (
            <div class={`msg ${msg.isBot ? 'bot' : ''}`}>
                <div class="msg-meta">
                    <span class="name">{senderLabel(msg)}</span>
                    <span class="time">{fmtTime(msg.time)}</span>
                </div>
                <div class="msg-body">
                    {msg.segments.map(seg => {
                        switch (seg.type) {
                            case 'text':
                                return <span class="seg-text">{seg.text}</span>;
                            case 'at':
                                return <span class="seg-at">@{seg.targetId}</span>;
                            case 'image': {
                                const desc = descCache.get(seg.sha256);
                                return (
                                    <span class="seg-image-wrap">
                                        <img src={`/api/images/file/${seg.sha256}`} alt={desc ?? seg.sha256} loading="lazy" />
                                        {desc && <span class="img-desc">{desc}</span>}
                                    </span>
                                );
                            }
                            case 'face':
                                return <span class="seg-face">[表情:{seg.id}]</span>;
                            case 'record':
                                return <span class="seg-media">[语音]</span>;
                            case 'video':
                                return <span class="seg-media">[视频 {seg.fileName ?? ''}]</span>;
                            case 'file':
                                return <span class="seg-media">[文件 {seg.fileName ?? ''}]</span>;
                            case 'json':
                                return <span class="seg-media">[JSON]</span>;
                            case 'poke':
                                return <span class="seg-action">[戳一戳 {seg.targetId}]</span>;
                            case 'dice':
                                return <span class="seg-action">[骰子:{seg.result}]</span>;
                            case 'rps':
                                return <span class="seg-action">[猜拳:{seg.result}]</span>;
                            case 'reply':
                                return <span class="seg-reply">[回复 #{seg.messageId}]</span>;
                            case 'forward':
                                return <span class="seg-forward">[合并转发:{seg.resId}]</span>;
                            default:
                                return <span class="seg-unknown">[未知]</span>;
                        }
                    })}
                </div>
            </div>
        ))}
        {messages.length === 0 && <p class="empty">暂无消息</p>}
    </div>
</Layout>

<style>
    .messages { display: flex; flex-direction: column; gap: 12px; }
    .msg {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 14px 18px;
    }
    .msg.bot { border-left: 3px solid var(--accent); }
    .msg-meta {
        display: flex; align-items: baseline; gap: 10px;
        margin-bottom: 8px;
    }
    .msg-meta .name {
        font-weight: 600; font-size: 14px; color: var(--text);
    }
    .msg-meta .time {
        font-size: 12px; color: var(--text-secondary);
    }
    .msg-body {
        font-size: 14px;
        line-height: 1.7;
        word-break: break-word;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 4px 6px;
    }
    .seg-text { color: var(--text); }
    .seg-at {
        color: var(--accent);
        background: rgba(108,122,224,0.12);
        padding: 1px 6px;
        border-radius: 4px;
        font-size: 13px;
    }
    .seg-image-wrap {
        display: inline-flex;
        flex-direction: column;
        gap: 4px;
        max-width: 100%;
    }
    .seg-image-wrap img {
        max-width: 320px;
        max-height: 240px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        object-fit: cover;
        cursor: pointer;
    }
    .img-desc {
        font-size: 12px;
        color: var(--text-secondary);
        max-width: 320px;
    }
    .seg-face, .seg-media, .seg-action, .seg-reply, .seg-forward, .seg-unknown {
        font-size: 13px;
        color: var(--text-secondary);
        background: var(--bg);
        padding: 2px 8px;
        border-radius: 4px;
    }
    .empty { color: var(--text-secondary); text-align: center; padding: 40px; }
</style>
