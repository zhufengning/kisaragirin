---
import Layout from '@layouts/Layout.astro';
import { config } from '@/config';

interface GraphitiEdge {
    uuid: string | null;
    name: string;
    fact: string;
    source_node_uuid: string | null;
    target_node_uuid: string | null;
    group_id: string;
    created_at: string | null;
    valid_at: string | null;
    invalid_at: string | null;
    expired_at: string | null;
    attributes: Record<string, unknown>;
}

const PAGE_SIZE = 20;
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const allGroups = config.input.group_whitelist.map(id => `group-${id}`);
const defaultGroupId = allGroups[0] || '';

// 支持 POST 搜索，避免 URL 过长导致浏览器崩溃
let searchQuery = '';
let groupId = Astro.url.searchParams.get('group_id')?.trim() || defaultGroupId;

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        searchQuery = (formData.get('search')?.toString() || '').trim();
        const formGroupId = formData.get('group_id')?.toString() || '';
        if (formGroupId) groupId = formGroupId;
    } catch {
        // formData 解析失败时保持默认值
    }

    // POST-Redirect-GET
    const redirectUrl = new URL(Astro.url);
    redirectUrl.searchParams.delete('page');
    if (searchQuery) {
        redirectUrl.searchParams.set('search', searchQuery);
    } else {
        redirectUrl.searchParams.delete('search');
    }
    redirectUrl.searchParams.set('group_id', groupId);
    return Astro.redirect(redirectUrl.pathname + redirectUrl.search);
} else {
    searchQuery = Astro.url.searchParams.get('search')?.trim() || '';
}

let edges: GraphitiEdge[] = [];
let totalCount = 0;
let totalPages = 1;
let error = '';

try {
    const graphiti = globalThis.__graphiti__;
    if (!graphiti || !graphiti.isReady) {
        error = 'Graphiti not initialized';
    } else if (searchQuery) {
        const result = await graphiti.search(searchQuery, groupId, PAGE_SIZE);
        edges = result.results;
        totalCount = result.count;
    } else {
        const offset = (currentPage - 1) * PAGE_SIZE;
        const result = await graphiti.getEdges(groupId, PAGE_SIZE, offset);
        edges = result.edges;
        totalCount = result.total;
        totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
    }
} catch (e: unknown) {
    console.error('[Graphiti Page] Error:', e);
    error = e instanceof Error ? e.message : String(e);
}

function pageUrl(page: number) {
    const url = new URL(Astro.url);
    url.searchParams.set('page', String(page));
    return url.pathname + url.search;
}

function formatDate(iso: string | null): string {
    if (!iso) return '';
    try {
        return new Date(iso).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' });
    } catch {
        return iso;
    }
}

---

<Layout title="记忆管理">
    <h1>记忆管理 <span class="meta">({searchQuery ? `搜索: "${searchQuery}"` : `${totalCount} 条`})</span></h1>

    {error && (
        <div class="error-banner">⚠️ {error}</div>
    )}

    <!-- 搜索栏 (POST 避免 URL 过长) -->
    <form class="search-bar" method="POST" action="/memories">
        <input
            type="text"
            name="search"
            value={searchQuery}
            placeholder="语义搜索记忆..."
            class="search-input"
        />
        <select name="group_id" class="search-input user-input">
            {allGroups.map(g => (
                <option value={g} selected={g === groupId}>{g}</option>
            ))}
        </select>
        <button type="submit" class="btn">🔍 搜索</button>
        {searchQuery && (
            <button type="submit" name="search" value="" class="btn btn-secondary">清除</button>
        )}
    </form>

    <!-- 记忆列表 -->
    <div class="memory-list">
        {edges.length === 0 && !error && (
            <p class="empty">{searchQuery ? '没有找到匹配的记忆' : '暂无记忆'}</p>
        )}
        
        {edges.map(e => (
            <div class="memory-card" data-uuid={e.uuid}>
                <div class="memory-header">
                    <span class="memory-id">{e.uuid?.slice(0, 8) ?? '—'}</span>
                    <span class="memory-name">{e.name}</span>
                    <span class="memory-time">
                        {e.valid_at && `生效: ${formatDate(e.valid_at)}`}
                        {e.invalid_at && ` · 失效: ${formatDate(e.invalid_at)}`}
                    </span>
                </div>
                <div class="memory-content">{e.fact}</div>
                <div class="memory-meta">
                    {e.created_at && <span>创建: {formatDate(e.created_at)}</span>}
                    {e.group_id && <span>组: {e.group_id}</span>}
                </div>
                <div class="memory-actions">
                    <button class="btn btn-sm btn-danger" data-action="delete" data-uuid={e.uuid}>删除</button>
                </div>
            </div>
        ))}
    </div>

    <!-- 分页导航 -->
    {!searchQuery && totalPages > 1 && (
        <nav class="pagination">
            <a
                href={pageUrl(currentPage - 1)}
                class={`page-btn ${currentPage <= 1 ? 'disabled' : ''}`}
                aria-disabled={currentPage <= 1}
            >
                ← 上一页
            </a>
            <span class="page-info">
                第 {currentPage} / {totalPages} 页
            </span>
            <a
                href={pageUrl(currentPage + 1)}
                class={`page-btn ${currentPage >= totalPages ? 'disabled' : ''}`}
                aria-disabled={currentPage >= totalPages}
            >
                下一页 →
            </a>
        </nav>
    )}
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // 记忆列表事件委托
        document.querySelector('.memory-list')?.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest('[data-action]') as HTMLElement | null;
            if (!btn) return;
            const action = btn.dataset.action;
            if (action === 'delete') {
                const uuid = btn.dataset.uuid || '';
                if (!uuid) return;
                if (!confirm('确定删除这条记忆？')) return;
                fetch(`/api/memories/${uuid}`, { method: 'DELETE', credentials: 'same-origin' })
                    .then(res => {
                        if (!res.ok) throw new Error();
                        alert('删除成功！');
                        location.reload();
                    })
                    .catch(() => alert('删除失败'));
            }
        });
    });
</script>

<style>
    .search-bar {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }
    .search-input {
        flex: 1;
        min-width: 200px;
        padding: 8px 14px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        font-size: 14px;
        font-family: inherit;
    }
    .search-input.user-input {
        flex: 0 0 150px;
        min-width: 120px;
    }
    .search-input:focus {
        outline: none;
        border-color: var(--accent);
    }
    .search-input::placeholder {
        color: var(--text-secondary);
    }
    .error-banner {
        padding: 12px 16px;
        background: rgba(224, 108, 117, 0.15);
        border: 1px solid var(--danger);
        border-radius: var(--radius-sm);
        color: var(--danger);
        margin-bottom: 16px;
    }
    .memory-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .memory-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 16px;
        transition: background 0.15s;
    }
    .memory-card:hover {
        background: var(--surface-hover);
    }
    .memory-header {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }
    .memory-id {
        font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
        font-size: 12px;
        color: var(--text-secondary);
        background: var(--bg);
        padding: 2px 8px;
        border-radius: 4px;
    }
    .memory-name {
        font-size: 13px;
        color: var(--accent);
        font-weight: 500;
    }
    .memory-time {
        font-size: 12px;
        color: var(--text-secondary);
        margin-left: auto;
    }
    .memory-content {
        font-size: 14px;
        line-height: 1.6;
        color: var(--text);
        word-break: break-word;
    }
    .memory-meta {
        display: flex;
        gap: 12px;
        margin-top: 8px;
        font-size: 12px;
        color: var(--text-secondary);
    }
    .memory-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }
    .empty {
        color: var(--text-secondary);
        text-align: center;
        padding: 40px;
    }
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
        padding: 16px;
    }
    .page-btn {
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        font-size: 14px;
        text-decoration: none;
        transition: background 0.15s;
    }
    .page-btn:hover:not(.disabled) {
        background: var(--surface-hover);
        text-decoration: none;
    }
    .page-btn.disabled {
        opacity: 0.4;
        cursor: not-allowed;
        pointer-events: none;
    }
    .page-info {
        font-size: 14px;
        color: var(--text-secondary);
    }
</style>
