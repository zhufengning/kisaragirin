{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "baseUrl": ".",
        "verbatimModuleSyntax": false,
        "paths": {
            "@lib/*": ["src/lib/*", "../lib/*"],
            "@layouts/*": ["src/layouts/*"],
            "~/*": ["../src/*"],
            "@/*": ["../*"],
            "@lib": ["../lib/index.ts"]
        }
    }
}
