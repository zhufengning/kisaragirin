{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "verbatimModuleSyntax": false,
        "paths": {
            "@lib/*": ["./src/lib/*", "../lib/*"],
            "@layouts/*": ["./src/layouts/*"],
            "~/*": ["../src/*"],
            "@/*": ["../*"],
            "@lib": ["../lib/index.ts"]
        },
        "strict": true
    }
}
