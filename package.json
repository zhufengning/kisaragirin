{
    "name": "kisaragirin-onebot",
    "description": "基于 OneBot V11 的 QQ 群聊机器人",
    "version": "0.1.0",
    "author": "zhufengning <z@zhufn.fun>",
    "license": "BSD-3-Clause",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js",
            "require": "./dist/src/index.js"
        },
        "./*": [
            "./dist/src/*",
            "./dist/src/*.d.ts"
        ]
    },
    "typesVersions": {
        "*": {
            "*": [
                "./dist/src/*",
                "./dist/src/*.d.ts"
            ]
        }
    },
    "scripts": {
        "prepublish": "pnpm run build",
        "type:check": "tsc --noEmit",
        "type:watch": "tsc --noEmit --watch",
        "lint": "eslint ./src ./test",
        "start": "tsx ./src/index.ts",
        "build": "rimraf ./dist/ && tsc -p tsconfig.dist.json",
        "web:build": "cd web && astro build",
        "web:check": "cd web && astro check && tsc --noEmit",
        "web:lint": "cd web && eslint src",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "test:integration": "tsx --test --test-concurrency=1 test/integration/scenarios/*.test.ts"
    },
    "files": [
        "dist/**/*",
        "web/dist/**/*"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.6",
        "@types/ws": "^8.18.2",
        "@typescript/native": "npm:typescript@7.0.2",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.14.0",
        "eslint-plugin-astro": "^3.2.1",
        "globals": "^17.14.0",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.12",
        "@astrojs/node": "^11.1.9",
        "@earendil-works/pi-agent-core": "1.5.0",
        "@earendil-works/pi-ai": "1.5.0",
        "@earendil-works/pi-coding-agent": "1.5.0",
        "astro": "^7.4.5",
        "better-sqlite3": "^13.0.3",
        "chalk": "^6.0.1",
        "croner": "^11.0.0",
        "cytoscape": "^3.34.4",
        "drizzle-orm": "^0.45.4",
        "jsonrepair": "^3.15.0",
        "openai": "^7.47.0",
        "sharp": "^0.35.5",
        "smol-toml": "^1.9.1",
        "typebox": "^1.3.27",
        "ws": "^8.22.0"
    },
    "optionalDependencies": {
        "bufferutil": "^4.1.0"
    }
}
