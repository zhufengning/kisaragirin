{
    "name": "philia-onebot",
    "description": "Fastly build your own QQ bot",
    "version": "1.4.1",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js",
            "require": "./dist/src/index.js"
        },
        "./*": [
            "./dist/src/*",
            "./dist/src/*.d.ts"
        ]
    },
    "typesVersions": {
        "*": {
            "*": [
                "./dist/src/*",
                "./dist/src/*.d.ts"
            ]
        }
    },
    "scripts": {
        "prepublish": "yarn run build",
        "type:check": "tsc --noEmit",
        "type:watch": "tsc --noEmit --watch",
        "lint": "eslint ./src --ext .ts",
        "start": "yarn web:build;tsx ./src/index.ts",
        "build": "rimraf ./dist/ && tsc -p tsconfig.dist.json",
        "web:build": "cd web && astro build",
        "web:check": "cd web && astro check && tsc --noEmit",
        "web:lint": "cd web && eslint src --ext .ts,.astro",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio"
    },
    "files": [
        "dist/**/*",
        "web/dist/**/*"
    ],
    "devDependencies": {
        "@anthropic-ai/sdk": "^0.40.1",
        "@azure/identity": "^4.0.0",
        "@azure/search-documents": "^12.0.0",
        "@cloudflare/workers-types": "^4.20250504.0",
        "@google/genai": "^1.2.0",
        "@langchain/core": "^1.1.47",
        "@mistralai/mistralai": "^1.5.2",
        "@supabase/supabase-js": "^2.49.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/cytoscape": "^3.31.0",
        "@types/jest": "29.5.14",
        "@types/node": "^22.10.2",
        "@types/pg": "8.11.0",
        "@types/ws": "^8.5.13",
        "@typescript-eslint/eslint-plugin": "^8.18.1",
        "@typescript-eslint/parser": "^8.18.1",
        "cloudflare": "^4.2.0",
        "compromise": "^14.0.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^8",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "groq-sdk": "0.3.0",
        "natural": "^8.0.1",
        "ollama": "^0.5.14",
        "pg": "8.11.3",
        "redis": "^4.6.13",
        "rimraf": "^6.0.1",
        "tsx": "^4.19.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/node": "^10.1.2",
        "@earendil-works/pi-agent-core": "^0.80.2",
        "@earendil-works/pi-ai": "^0.80.2",
        "@qdrant/js-client-rest": "^1.19.0",
        "astro": "^6.4.0",
        "better-sqlite3": "^12.6.2",
        "chalk": "^5.4.0",
        "croner": "^10.0.1",
        "cytoscape": "^3.34.2",
        "drizzle-orm": "^0.45.2",
        "mem0ai": "3.1.2",
        "openai": "^7.8.0",
        "sharp": "^0.34.5",
        "smol-toml": "^1.6.1",
        "ws": "^8.18.0"
    },
    "optionalDependencies": {
        "bufferutil": "^4.0.8"
    }
}
